import sys
import time
import math
import numpy as np
import pyigtl  # Connexió nativa amb 3D Slicer
from NatNetClient import NatNetClient

# Diccionari global per guardar el frame actual de Motive
# Clau: ID de l'objecte, Valor: [posició_global, rotació_quaternion]
rigid_bodies_data = {}

def receive_rigid_body_frame(new_id, position, rotation):
    """Callback asíncron que s'executa per cada Rigid Body de Motive."""
    global rigid_bodies_data
    rigid_bodies_data[new_id] = [position, rotation]

def quaternion_to_rotation_matrix(q):
    """Converteix un quaternió [x, y, z, w] de Motive en una matriu de rotació 3x3."""
    x, y, z, w = q
    return np.array([
        [1 - 2*y**2 - 2*z**2,     2*x*y - 2*z*w,         2*x*z + 2*y*w],
        [2*x*y + 2*z*w,           1 - 2*x**2 - 2*z**2,   2*y*z - 2*x*w],
        [2*x*z - 2*y*w,           2*y*z + 2*x*w,         1 - 2*x**2 - 2*y**2]
    ])

def calculate_absolute_ras_matrix(p_glob, q_glob):
    """
    Agafa la posició en m i el quaternió de Motive, aplica el canvi de base
    i retorna la matriu homogènia 4x4 en valor absolut RAS (en mm).
    """
    # 1. Translació absoluta i re-mapeig d'eixos (Motive Y-up -> Slicer RAS Z-up)
    p_ras = [
         p_glob[0] * 1000.0,  
         p_glob[2] * 1000.0,  
         p_glob[1] * 1000.0    
    ]
    
    # 2. Convertim el quaternió real de Motive a matriu de rotació 3x3
    R_motive = quaternion_to_rotation_matrix(q_glob)
    
    # 3. Matriu de canvi de base
    M_remap = np.array([
        [1,  0,  0],
        [0,  0, -1],
        [0,  1,  0]
    ])
    
    # 4. S'aplica la transformació de semblança algebraica per a la rotació
    R_ras = M_remap @ R_motive @ M_remap.T
    
    # 5. Construcció de la matriu homogènia final 4x4
    matrix = np.eye(4)
    matrix[0:3, 0:3] = R_ras
    matrix[0:3, 3] = p_ras
    return matrix

if __name__ == "__main__":
    optionsDict = {"clientAddress": "127.0.0.1", "serverAddress": "127.0.0.1"}
    streaming_client = NatNetClient()

    print("    MIDDLEWARE (MOTIVE -> 3D SLICER)   ")

    cast_choice = input("Selecciona xarxa de Motive (0 per Multicast, 1 per Unicast): ")
    optionsDict["use_multicast"] = True if int(cast_choice) == 0 else False
    streaming_client.set_use_multicast(optionsDict["use_multicast"])

    client_ip = input("IP d'aquest PC (Client) [Intro per 127.0.0.1]: ") or "127.0.0.1"
    server_ip = input("IP de Motive (Servidor) [Intro per 127.0.0.1]: ") or "127.0.0.1"
    streaming_client.set_client_address(client_ip)
    streaming_client.set_server_address(server_ip)

    print("Inicialitzant Servidor OpenIGTLink al port 18944.")
    igtl_server = pyigtl.OpenIGTLinkServer(port=18944)

    streaming_client.rigid_body_listener = receive_rigid_body_frame
    streaming_client.set_print_level(0)

    if not streaming_client.run("d"):
        print("[ERROR] No s'ha pogut arrencar el mòdul NatNetClient.")
        sys.exit(1)

    time.sleep(1)
    if not streaming_client.connected():
        print("[ERROR] Connexió fallida amb Motive.")
        sys.exit(2)

    print("\n[OK] Connexió correcta")
    
    try:

        # MAPEIG DE TOTS ELS COSSOS RIGIDS (Configuració de tracking)
        # Assignem a cada ID de Motive el seu nom de dispositiu per a 3D Slicer
        COSSOS_CONFIG = {
            1: "PacientReferencia",
            2: "TransductorSimulat",
            3: "EinaAuxiliar"      
        }

        while True:
            if rigid_bodies_data:
                # Iterem dinàmicament per la configuració configurada dels 3 cossos
                for body_id, device_name in COSSOS_CONFIG.items():
                    if body_id in rigid_bodies_data:
                        # Extraiem la cinemàtica (posició i quaternió) del cos des del callback
                        p_glob, q_glob = rigid_bodies_data[body_id]
                        
                        # Calculem la transformació matemàtica homogènia 4x4 (canvi d'eixos i mm)
                        matriu_ras = calculate_absolute_ras_matrix(p_glob, q_glob)
                        
                        # S'empaqueta i s'envia independentment a Slicer amb el seu àlies
                        msg = pyigtl.TransformMessage(matriu_ras, device_name=device_name)
                        igtl_server.send_message(msg)
            
            # Freqüència fixada a 120 Hz
            time.sleep(1/120)

    except KeyboardInterrupt:
        print("\n[INFO] Actualitzant dades")
        streaming_client.shutdown()