import sys
import time
import csv
import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D 
from NatNetClient import NatNetClient

EXPERIMENT_DURATION = 300
TARGET_ID = 1              # ID de l'Stylus

# Llistes globals per a l'acumulació de dades
timestamps = []
pos_x = []
pos_y = []
pos_z = []

start_time = None
experiment_running = True

def receive_rigid_body_frame(new_id, position, rotation):
    """Callback asíncron que captura els paquets UDP de Motive."""
    global timestamps, pos_x, pos_y, pos_z, start_time, experiment_running
    
    if experiment_running and new_id == TARGET_ID:
        current_time = time.time()
        if start_time is None:
            start_time = current_time
            
        elapsed_time = current_time - start_time
        
        timestamps.append(elapsed_time)
        pos_x.append(position[0] * 1000.0)  # Convertim a mm
        pos_y.append(position[1] * 1000.0)  # Convertim a mm
        pos_z.append(position[2] * 1000.0)  # Convertim a mm

if __name__ == "__main__":
    streaming_client = NatNetClient()
    streaming_client.set_client_address("127.0.0.1")
    streaming_client.set_server_address("127.0.0.1")
    streaming_client.set_use_multicast(False)  # Forçat a Unicast per seguretat
    
    streaming_client.rigid_body_listener = receive_rigid_body_frame
    streaming_client.set_print_level(0)
    
    print("      TEST AVANÇAT D'ESTABILITAT: JITTER & EXCEL    ")

    if not streaming_client.run("d"):
        sys.exit(1)
        
    time.sleep(1)
    if not streaming_client.connected():
        print("[ERROR] Connexió fallida.")
        sys.exit(2)
        
    print("\n[OK] Connexió activa.")
    
    while start_time is None:
        time.sleep(0.05)
        
    print("Temporitzador de 5 minuts ON")
    
    try:
        while True:
            elapsed = time.time() - start_time
            if elapsed >= EXPERIMENT_DURATION:
                break
            print(f"Temps: {elapsed:.1f}s / {EXPERIMENT_DURATION}s | Frames: {len(timestamps)}", end="\r")
            time.sleep(0.5)
    except KeyboardInterrupt:
        print("\n\n[INFO] Experiment interromput manualment.")
        
    experiment_running = False
    streaming_client.shutdown()
    
    print("\n\n[OK] Captura finalitzada.")
    
    # Conversió a arrays de Numpy per a càlculs ràpids
    t = np.array(timestamps)
    x = np.array(pos_x)
    y = np.array(pos_y)
    z = np.array(pos_z)
    
    # Càlcul de mètriques estadístiques
    mean_x, mean_y, mean_z = np.mean(x), np.mean(y), np.mean(z)
    jitter_x = x - mean_x
    jitter_y = y - mean_y
    jitter_z = z - mean_z
    std_x, std_y, std_z = np.std(x), np.std(y), np.std(z)
    rms_global = np.sqrt(std_x**2 + std_y**2 + std_z**2)
    
    print(f"\n--> ERROR VOLUMÈTRIC GLOBAL (RMS): {rms_global:.4f} mm")
    
    # GESTIÓ I EXPORTACIÓ A EXCEL
    nom_fitxer_excel = "dades_jitter_tfg.csv"
    print(f"\n[INFO] Exportant dades a '{nom_fitxer_excel}'...")
    
    with open(nom_fitxer_excel, mode='w', newline='') as fitxer_csv:
        # Utilitzar el ';' fa que Excel obre el fitxer directament en columnes
        escriptor = csv.writer(fitxer_csv, delimiter=';')
        
        # Capçalera de l'Excel
        escriptor.writerow(['Temps (s)', 'Pos X (mm)', 'Pos Y (mm)', 'Pos Z (mm)', 'Jitter X (mm)', 'Jitter Y (mm)', 'Jitter Z (mm)'])
        
        # Bolcatge de dades frame a frame
        for i in range(len(t)):
            # Escrivim canviant els punts decimals per comes per a la versió d'Excel
            escriptor.writerow([
                str(t[i]).replace('.', ','),
                str(x[i]).replace('.', ','),
                str(y[i]).replace('.', ','),
                str(z[i]).replace('.', ','),
                str(jitter_x[i]).replace('.', ','),
                str(jitter_y[i]).replace('.', ','),
                str(jitter_z[i]).replace('.', ',')
            ])
            
    print(f"[OK] Fitxer d'Excel desat.")

    # Generació de gràfiques
    
    # --- GRÀFICA 1: SÈRIE TEMPORAL DEL SOROLL ---
    plt.figure(1, figsize=(10, 4))
    plt.plot(t, jitter_x, label=f'Eix X (σ = {std_x:.4f} mm)', color='#d9534f', alpha=0.7, linewidth=0.8)
    plt.plot(t, jitter_y, label=f'Eix Y (σ = {std_y:.4f} mm)', color='#5cb85c', alpha=0.7, linewidth=0.8)
    plt.plot(t, jitter_z, label=f'Eix Z (σ = {std_z:.4f} mm)', color='#0275d8', alpha=0.7, linewidth=0.8)
    plt.title("Gràfica A: Sèrie Temporal del Soroll de Jitter", fontsize=11, fontweight='bold')
    plt.xlabel("Temps (segons)")
    plt.ylabel("Desviació respecte al repòs (mm)")
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.legend(loc='upper right')
    plt.xlim(0, EXPERIMENT_DURATION)
    plt.savefig("jitter_1_temps.png", dpi=100, bbox_inches='tight')
    
    # --- GRÀFICA 2: HISTOGRAMA DE DISTRIBUCIÓ GAUSSIANA ---
    plt.figure(2, figsize=(10, 4))
    plt.hist(jitter_x, bins=100, density=True, alpha=0.5, color='#d9534f', label='Distribució X')
    plt.hist(jitter_y, bins=100, density=True, alpha=0.5, color='#5cb85c', label='Distribució Y')
    plt.hist(jitter_z, bins=100, density=True, alpha=0.5, color='#0275d8', label='Distribució Z')
    plt.title("Gràfica B: Histograma i Densitat de Probabilitat del Soroll", fontsize=11, fontweight='bold')
    plt.xlabel("Magnitud de l'error de Jitter (mm)")
    plt.ylabel("Densitat de freqüència")
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.legend(loc='upper right')
    plt.savefig("jitter_2_histograma.png", dpi=100, bbox_inches='tight')
    
    plt.show()